# Port the web UI + API listen on (inside the container).
TOSSARR_PORT=8901

# How often to re-sync libraries from Sonarr/Radarr, in hours.
SYNC_INTERVAL_HOURS=6

# Days before a kept item re-enters the deck.
KEEP_REAPPEAR_DAYS=30

# Where settings.json and tossarr.db live. Container default: /config.
# For local dev without Docker you can point this at a writable directory,
# e.g. TOSSARR_CONFIG_DIR=./dev-config
TOSSARR_CONFIG_DIR=/config
